+
+        $logs = $order->fresh()->statusLogs;
+        $this->assertSame(['draft', 'menunggu_pembayaran', 'menunggu_verifikasi'], $logs->pluck('to_status')->all());
+        $this->assertNull($logs[0]->from_status);
